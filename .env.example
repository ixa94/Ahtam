# Пароль страницы /admin. Обязательно уникальный, не короче 16 символов;
# рекомендуется случайная строка длиной 32+ символа.
ADMIN_PASSWORD=generate_a_unique_random_password_of_32_or_more_characters

# Email-уведомления о новых заявках.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your_address@example.com
SMTP_PASS=your_application_password
SMTP_TO=destination@example.com

# Боты для уведомлений. ID получателей настраиваются в /admin.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# Supabase нужен только при использовании базы вместо локальных JSON-файлов.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
